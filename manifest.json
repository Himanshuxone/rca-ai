{
  "name": "My Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "frontend/services/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frontend/assets/*.jpg",
        "frontend/src/index.js",
        "frontend/src/index.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
